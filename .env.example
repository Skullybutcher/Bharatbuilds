# Copy to .env (NEVER commit .env). Teammate: fill keys, `source .env` before deploy.
# Local runs need none of this (file storage, deterministic parser, no AWS).

# --- AWS identity (teammate provisions; prefer SSO, else least-privilege IAM user) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- Model runtime (extraction fallback only; parser is the fast path) ---
# ap-south-1 reaches Nova Micro via the APAC cross-region inference profile.
MODEL_ID=apac.amazon.nova-micro-v1:0
PROCESSPATCH_MODEL_FALLBACK=0

# --- Deploy outputs (filled after `sam deploy`; used by UI + smoke tests) ---
AMPLIFY_TOKEN=
STATEMACHINE_ARN=
API_URL=http://localhost:8000

# --- Local backend selection (files locally; Lambda sets dynamodb) ---
PROCESSPATCH_STORAGE=files
PROCESSPATCH_DATA=./data

# --- Auth (see docs/auth.md) ---
# off = local dev, credential-free, legacy behavior. cognito = enforce JWTs.
# hs256-test = TEST ONLY (offline enforcement tests with PP_DEV_HS256_SECRET).
PROCESSPATCH_AUTH=off
PP_DEV_HS256_SECRET=
# Production values (filled by infra/deploy.sh from stack outputs; ApiFn gets
# these from CloudFormation, the UI fetches them from GET /auth/config):
PP_USER_POOL_ID=
PP_CLIENT_ID=
PP_AUTH_DOMAIN=
# Lock CORS to the Amplify origin in production (never leave * on real deploys).
FRONTEND_ORIGIN=*
