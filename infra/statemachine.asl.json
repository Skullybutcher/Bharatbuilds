{
  "Comment": "ProcessPatch compile-test-patch pipeline with human governance gates (Spec 57G). INGEST carries only S3 key + ids (EventBridge auto-start is DISABLED for the hackathon; the API starts executions with a complete envelope). SET_BUILD_ID derives the id from the artifact hash; PERSIST_BUILD stores the cloud build before the first approval wait so resume callbacks load real state; FETCH_CANDIDATE reads (never re-creates) the approved candidate; MARK_ACTIVE flips build status after ACTIVATE. Human waits use taskToken callbacks persisted server-side (POST /builds/{id}/resume).",
  "StartAt": "INGEST",
  "States": {
    "INGEST": {"Type": "Pass", "Comment": "Envelope from the API: policy_s3_key, policy_version_id, workflow_id, workspace_id, procedure_version_id.", "Next": "LOAD_BUILD_CONTEXT"},
    "LOAD_BUILD_CONTEXT": {
      "Type": "Task", "Resource": "${GovernFnArn}",
      "Comment": "Reads S3 policy text, resolves active procedure + previous policy rules.",
      "Parameters": {"op": "load_context", "policy_s3_key.$": "$.policy_s3_key", "policy_text.$": "$.policy_text", "procedure.$": "$.procedure", "old_rules.$": "$.old_rules", "policy_version_id.$": "$.policy_version_id", "workflow_id.$": "$.workflow_id", "workspace_id.$": "$.workspace_id", "procedure_version_id.$": "$.procedure_version_id"},
      "ResultPath": "$.build_context", "Retry": [{"ErrorEquals": ["States.ALL"], "MaxAttempts": 2}],
      "Next": "HASH_ARTIFACT"
    },
    "HASH_ARTIFACT": {
      "Type": "Task", "Resource": "${GovernFnArn}", "Comment": "Idempotency hash over policy+procedure+compiler; also mints provisional build_id.",
      "Parameters": {"op": "hash", "policy_text.$": "$.build_context.policy_text", "procedure.$": "$.build_context.procedure"},
      "ResultPath": "$.artifact_hash",
      "Next": "SET_BUILD_ID"
    },
    "SET_BUILD_ID": {"Type": "Pass", "InputPath": "$.artifact_hash.build_id", "ResultPath": "$.build_id", "Next": "EXTRACT_RULES"},
    "EXTRACT_RULES": {
      "Type": "Task", "Resource": "${ExtractorFnArn}",
      "Parameters": {"policy_text.$": "$.build_context.policy_text", "policy_version_id.$": "$.build_context.policy_version_id", "build_id.$": "$.build_id"},
      "ResultPath": "$.extraction", "Retry": [{"ErrorEquals": ["States.ALL"], "MaxAttempts": 2}],
      "Next": "VALIDATE_RULE_IR"
    },
    "VALIDATE_RULE_IR": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.extraction.schema_valid", "BooleanEquals": false, "Next": "EXTRACTION_FAILURE"}],
      "Default": "CHECK_IDEMPOTENT"
    },
    "CHECK_IDEMPOTENT": {
      "Type": "Task", "Resource": "${GovernFnArn}", "Comment": "compile_key lookup; duplicates reuse the existing build.",
      "Parameters": {"op": "find_by_key", "new_rules.$": "$.extraction.rules", "procedure.$": "$.build_context.procedure"},
      "ResultPath": "$.idempotency",
      "Next": "IDEMPOTENT_HIT?"
    },
    "IDEMPOTENT_HIT?": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.idempotency.idempotent_reuse", "BooleanEquals": true, "Next": "READY_CACHED"}],
      "Default": "CANONICALIZE_BUILD_ID"
    },
    "CANONICALIZE_BUILD_ID": {"Type": "Pass", "Comment": "T68: HASH mints build_id PROVISIONALLY from policy+procedure (rules don't exist yet); compile_key = sha(accepted rules+procedure) is the canonical identity and local run_build has always set build_id = compile_key. Reconcile here — before any consumer — so persist, callbacks, gates, certificates and reverify all see ONE identity. Crossed identities made every activated cloud build fail reverify on fields nobody tampered with. T68b: InputPath, NOT Parameters — Parameters+ResultPath would nest an OBJECT at $.build_id ({build_id:...}) and every downstream $.build_id reference would die as States.Runtime; InputPath selects the compile_key STRING and ResultPath overwrites the field in place.", "InputPath": "$.idempotency.compile_key", "ResultPath": "$.build_id", "Next": "RESOLVE_AUTHORITY"},
    "RESOLVE_AUTHORITY": {"Type": "Pass", "Comment": "Attach source precedence metadata; conflicts fail closed downstream.", "Next": "RULE_REVIEW_REQUIRED?"},
    "RULE_REVIEW_REQUIRED?": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.extraction.status", "StringEquals": "NEEDS_REVIEW", "Next": "WAIT_FOR_RULE_REVIEW"},
        {"Variable": "$.extraction.status", "StringEquals": "CONFLICT", "Next": "NEEDS_REVIEW"}
      ],
      "Default": "SET_ACCEPTED_DEFAULT"
    },
    "SET_ACCEPTED_DEFAULT": {
      "Type": "Pass", "Comment": "No review required: deterministic extraction output IS the accepted rule set (audited).",
      "Parameters": {"accepted_rules.$": "$.extraction.rules"},
      "ResultPath": "$.review",
      "Next": "COMPILE_CONSTRAINTS"
    },
    "WAIT_FOR_RULE_REVIEW": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {"FunctionName": "${GovernFnArn}", "Payload": {"op": "open_reviews", "build_id.$": "$.build_id", "rules.$": "$.extraction.rules", "taskToken.$": "$$.Task.Token"}},
      "ResultPath": "$.rule_review_wait",
      "HeartbeatSeconds": 86400,
      "Next": "RULE_REVIEW_DECIDED?"
    },
    "RULE_REVIEW_DECIDED?": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.rule_review_wait.accepted", "BooleanEquals": true, "Next": "USE_REVIEWED_RULES"}],
      "Default": "NEEDS_REVIEW"
    },
    "USE_REVIEWED_RULES": {
      "Type": "Pass", "Comment": "Resume payload carries accepted_rules from the review API.",
      "Parameters": {"accepted_rules.$": "$.rule_review_wait.accepted_rules"},
      "ResultPath": "$.review",
      "Next": "COMPILE_CONSTRAINTS"
    },
    "COMPILE_CONSTRAINTS": {
      "Type": "Task", "Resource": "${CompilerFnArn}",
      "Parameters": {"op": "compile", "old_rules.$": "$.build_context.old_rules", "new_rules.$": "$.review.accepted_rules"},
      "ResultPath": "$.compiled",
      "Next": "CHECK_CONFLICT"
    },
    "CHECK_CONFLICT": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.compiled.error", "IsPresent": true, "Next": "NEEDS_REVIEW"}],
      "Default": "SEMANTIC_DIFF"
    },
    "SEMANTIC_DIFF": {"Type": "Pass", "Comment": "Surfaces $.compiled.semantic_delta; behavioral vs no-op vs provenance-only.", "Next": "FIND_WITNESSES"},
    "FIND_WITNESSES": {
      "Type": "Task", "Resource": "${WitnessFnArn}",
      "Parameters": {"new_rules.$": "$.review.accepted_rules", "procedure.$": "$.build_context.procedure"},
      "ResultPath": "$.witnesses_out",
      "Next": "CHECK_WITNESSES"
    },
    "CHECK_WITNESSES": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.witnesses_out.witnesses_found", "BooleanEquals": false, "Next": "GENERATE_CERTIFICATE_CLEAN"}],
      "Default": "LOCALIZE_PATCH"
    },
    "LOCALIZE_PATCH": {
      "Type": "Task", "Resource": "${CompilerFnArn}",
      "Parameters": {"op": "localize_patch", "old_rules.$": "$.build_context.old_rules", "new_rules.$": "$.review.accepted_rules", "procedure.$": "$.build_context.procedure", "witnesses.$": "$.witnesses_out.witnesses"},
      "ResultPath": "$.patched",
      "Next": "VALIDATE_PATCH"
    },
    "VALIDATE_PATCH": {
      "Type": "Task", "Resource": "${ValidatorFnArn}",
      "Parameters": {"build_id.$": "$.build_id", "policy_version_id.$": "$.build_context.policy_version_id", "old_rules.$": "$.build_context.old_rules", "new_rules.$": "$.review.accepted_rules", "procedure.$": "$.build_context.procedure", "patched_workflow.$": "$.patched.patched_workflow", "patch.$": "$.patched.patch", "witnesses.$": "$.witnesses_out.witnesses", "faults.$": "$.patched.faults", "semantic_delta.$": "$.compiled.semantic_delta", "with_certificate": true},
      "ResultPath": "$.validation_out",
      "Next": "CHECK_VALIDATION"
    },
    "CHECK_VALIDATION": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.validation_out.patch_valid", "BooleanEquals": true, "Next": "COMPUTE_IMPACT"}],
      "Default": "NEEDS_REVIEW"
    },
    "COMPUTE_IMPACT": {
      "Type": "Task", "Resource": "${ImpactFnArn}",
      "Comment": "Final impact: validated patch, final nodes, full regression + provenance.",
      "Parameters": {"build_id.$": "$.build_id", "policy_version_id.$": "$.build_context.policy_version_id", "old_rules.$": "$.build_context.old_rules", "new_rules.$": "$.review.accepted_rules", "procedure.$": "$.build_context.procedure", "patched_workflow.$": "$.patched.patched_workflow", "semantic_delta.$": "$.compiled.semantic_delta", "witnesses.$": "$.witnesses_out.witnesses", "faults.$": "$.patched.faults", "validation.$": "$.validation_out.validation"},
      "ResultPath": "$.impact",
      "Next": "GENERATE_CERTIFICATE"
    },
    "GENERATE_CERTIFICATE": {"Type": "Pass", "Comment": "Surfaces $.validation_out.certificate with clause-level sources; never claims compliance.", "Next": "PERSIST_BUILD"},
    "PERSIST_BUILD": {
      "Type": "Task", "Resource": "${GovernFnArn}",
      "Comment": "Store the cloud build BEFORE the first approval wait so resume callbacks load real state.",
      "Parameters": {"op": "persist_build", "build_id.$": "$.build_id", "compile_key.$": "$.idempotency.compile_key", "policy_version_id.$": "$.build_context.policy_version_id", "status": "PATCH_VALIDATED", "semantic_delta.$": "$.compiled.semantic_delta", "witnesses.$": "$.witnesses_out.witnesses", "faults.$": "$.patched.faults", "patch.$": "$.patched.patch", "patched_workflow.$": "$.patched.patched_workflow", "validation.$": "$.validation_out.validation", "impact.$": "$.impact", "certificate.$": "$.validation_out.certificate", "new_rules.$": "$.review.accepted_rules", "old_rules.$": "$.build_context.old_rules", "procedure.$": "$.build_context.procedure", "review_state": "REVIEWED", "policy_sha256.$": "$.artifact_hash.sha256"},
      "ResultPath": "$.persisted",
      "Next": "WAIT_FOR_PATCH_APPROVAL"
    },
    "WAIT_FOR_PATCH_APPROVAL": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {"FunctionName": "${GovernFnArn}", "Payload": {"op": "request_review", "build_id.$": "$.build_id", "taskToken.$": "$$.Task.Token"}},
      "ResultPath": "$.patch_decision", "HeartbeatSeconds": 86400,
      "Next": "PATCH_APPROVED?"
    },
    "PATCH_APPROVED?": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$.patch_decision.decision", "StringEquals": "APPROVE_CANDIDATE", "Next": "FETCH_CANDIDATE"},
        {"Variable": "$.patch_decision.decision", "StringEquals": "REQUEST_REVISION", "Next": "REVISION_REQUIRED"}
      ],
      "Default": "CLOSED_REJECTED"
    },
    "FETCH_CANDIDATE": {
      "Type": "Task", "Resource": "${GovernFnArn}",
      "Comment": "Read-only: the candidate was minted once by decide_patch (single owner).",
      "Parameters": {"op": "get_candidate", "build_id.$": "$.build_id"},
      "ResultPath": "$.candidate",
      "Next": "WAIT_FOR_ACTIVATION_APPROVAL"
    },
    "WAIT_FOR_ACTIVATION_APPROVAL": {
      "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {"FunctionName": "${GovernFnArn}", "Payload": {"op": "resume", "kind": "activation", "build_id.$": "$.build_id", "taskToken.$": "$$.Task.Token"}},
      "ResultPath": "$.activation_decision", "HeartbeatSeconds": 86400,
      "Next": "ACTIVATION_APPROVED?"
    },
    "ACTIVATION_APPROVED?": {
      "Type": "Choice",
      "Choices": [{"Variable": "$.activation_decision.decision", "StringEquals": "APPROVE", "Next": "ACTIVATE"}],
      "Default": "CLOSED_REJECTED"
    },
    "ACTIVATE": {
      "Type": "Task", "Resource": "${GovernFnArn}",
      "Comment": "Single owner of the activation side effect; loads the persisted build for hash verification.",
      "Parameters": {"op": "activate", "build_id.$": "$.build_id", "reviewer.$": "$.activation_decision.reviewer", "reason.$": "$.activation_decision.reason"},
      "ResultPath": "$.activation",
      "Next": "MARK_ACTIVE"
    },
    "MARK_ACTIVE": {
      "Type": "Task", "Resource": "${GovernFnArn}",
      "Parameters": {"op": "mark_status", "build_id.$": "$.build_id", "status": "PATCH_ACTIVE"},
      "ResultPath": "$.marked",
      "Next": "READY"
    },
    "GENERATE_CERTIFICATE_CLEAN": {"Type": "Pass", "Comment": "No drift: record clean bill, no patch, no approval needed.", "Next": "READY"},
    "READY_CACHED": {"Type": "Succeed", "Comment": "Idempotent reuse of an existing build."},
    "NEEDS_REVIEW": {"Type": "Pass", "Comment": "AMBIGUOUS_RULE | CONFLICTING_RULES | EXTRACTION_FAILURE | NO_VALID_PATCH -> human review.", "Next": "CLOSED_REVIEW"},
    "CLOSED_REVIEW": {"Type": "Succeed", "Comment": "Closed pending human review."},
    "CLOSED_REJECTED": {"Type": "Succeed", "Comment": "Reviewer rejected; candidate retained inactive; activation blocked."},
    "REVISION_REQUIRED": {"Type": "Succeed", "Comment": "Reviewer requested revision; next patch iteration references this one."},
    "EXTRACTION_FAILURE": {"Type": "Fail", "Error": "EXTRACTION_FAILURE", "Cause": "Schema validation failed; retry constrained extraction, then NEEDS_REVIEW."},
    "READY": {"Type": "Succeed"}
  }
}
